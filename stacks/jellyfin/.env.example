TZ=Europe/Rome

JELLYFIN_TAG=10.11.11
JELLYFIN_PORT=8096
JELLYFIN_CONFIG_PATH=./data/jellyfin/config
JELLYFIN_CACHE_PATH=./data/jellyfin/cache
JELLYFIN_MEDIA_PATH=./data/jellyfin/media

# Break-glass local admin, created by the first-run wizard. Every real person
# (the owner included) is provisioned by the SSO plugin on first login instead;
# this account exists only so a broken Authentik cannot lock the household out.
# See docs/04_apps/jellyfin.md §8 for why no personal account is pre-created.
JELLYFIN_LOCAL_ADMIN_USER=jellyfin-admin
JELLYFIN_LOCAL_ADMIN_PASSWORD=CHANGE_ME_GENERATE_LONG_RANDOM

# GPU transcoding is intentionally not enabled in the default Compose file.
# Add a local override that maps /dev/dri only after GPU passthrough is validated.
