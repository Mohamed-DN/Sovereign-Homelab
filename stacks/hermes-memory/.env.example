# Hermes memory stores on LXC 102 (apps-light, 192.168.1.52).
# Copy to .env and replace every REPLACE_ME. Never commit the real .env.
#
# The live values are generated once by scripts/sovereign-hermes-memory-secrets.sh
# on the Proxmox host, which also drops the connection files Hermes reads from
# /root/sovereign-secrets/hermes/.

HERMES_PG_TAG=16-alpine
HERMES_PG_DB=hermes_memory
HERMES_PG_USER=hermes
HERMES_PG_PORT=5432
# openssl rand -base64 32 (no shell-special characters)
HERMES_PG_PASSWORD=REPLACE_ME

HERMES_QDRANT_TAG=v1.18.3
HERMES_QDRANT_PORT=6333
# openssl rand -hex 32
HERMES_QDRANT_API_KEY=REPLACE_ME
# openssl rand -hex 32 - read-only key, for anything that must not write
HERMES_QDRANT_READ_KEY=REPLACE_ME

HERMES_VALKEY_TAG=9.1.1-alpine
HERMES_VALKEY_PORT=6379
HERMES_VALKEY_MAXMEMORY=256mb
# openssl rand -hex 32
HERMES_VALKEY_PASSWORD=REPLACE_ME
