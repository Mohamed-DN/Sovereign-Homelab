# OmniRoute - the LLM gateway on LXC 102 (apps-light, 192.168.1.52).
# Copy to .env and replace every REPLACE_ME. Never commit the real .env.
#
# The live values are generated by scripts/sovereign-omniroute-secrets.sh,
# which writes them to /root/sovereign-secrets/omniroute/ (0600) on the
# Proxmox host and prints the .env body.

OMNIROUTE_TAG=3.8.48
OMNIROUTE_PORT=20128
OMNIROUTE_LIVE_WS_PORT=20132

# openssl rand -base64 48
OMNIROUTE_JWT_SECRET=REPLACE_ME
# openssl rand -hex 32
OMNIROUTE_API_KEY_SECRET=REPLACE_ME
# openssl rand -hex 32 - encrypts the SQLite database at rest
OMNIROUTE_STORAGE_ENCRYPTION_KEY=REPLACE_ME
# openssl rand -hex 16 - per-deployment machine-id salt
OMNIROUTE_MACHINE_ID_SALT=REPLACE_ME

# First dashboard login for the owner. This estate reuses the shared
# app password from /root/sovereign-secrets/common-app-password.
OMNIROUTE_INITIAL_PASSWORD=REPLACE_ME
